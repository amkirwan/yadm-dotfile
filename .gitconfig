[init]
  templatedir = ~/.git_template
[branch]
  autosetuprebase = always
[push]
  default = current
[color]
  ui = auto
[date]
  relative
[merge]
  ff = only
[commit]
  template = ~/.gitmessage
[core]
  editor = nvim
[fetch]
  prune = true
[apply]
  whitespace = fix
[rebase]
  autosquash = true
[include]
  path = ~/.gitconfig.local
  path = ~/.gitconfig.extras
[diff]
  colorMoved = zebra
[pretty]
  colored = format:%Cred%h%Creset %s %Cgreen(%cr) %C(bold gray)%an%Creset
	name = akirwan
[gpg]
	format = x509
[gpg "x509"]
	program = /opt/uber/bin/signingfx
[user]
	signingkey = C8:64:D4:26:C1:DC:0F:10:7C:63:9B:CB:79:39:CE:7B:81:56:DA:30
